# Copy to .env.local (development) or .env.production.local (deploy). Never put AMB (game provider) secrets here.

# MariaDB: use the chok_admin user (see scripts/grants.sql). Same database as the member site.
DATABASE_URL=mysql://chok_admin:change-me@127.0.0.1:3306/lotto
DATABASE_POOL_SIZE=20
# "true" to connect with TLS; DATABASE_SSL_INSECURE=true skips certificate checks (testing only).
# DATABASE_SSL=true
# DATABASE_SSL_INSECURE=false
# "false" stops the admin migrations (employee_* tables) from running at startup; then run `npm run db -- migrate`.
# DB_AUTO_MIGRATE=true

# "off" keeps the background scheduler from running (used while the old app still owns it; see docs/runbook-cutover.md).
SCHEDULER=on
# Winning bills paid per settlement batch (default 500).
# SETTLE_CHUNK=500

# Same MongoDB as the member site (media, stats). Optional.
# MONGODB_URL=
# MONGODB_DB=chokprathan

NEXT_PUBLIC_SITE_URL=https://admin.example.com
# Behind a reverse proxy that sets X-Real-IP: take the client IP from it.
# MEMBER_SITE_URL=https://example.com
TRUST_PROXY=1
# Extra origins allowed to post Server Actions, comma-separated (only when a proxy rewrites the host name).
# ALLOWED_ORIGINS=admin.example.com

# Read only to show on the settings page whether the member app's SMS provider is configured; the admin
# app never sends SMS. Leave unset unless you want that notice gone (the values are the member's secrets).
# SMS_PROVIDER=thaibulksms
# THAIBULKSMS_API_KEY=
# THAIBULKSMS_API_SECRET=

# Tests only (never in a deploy env file): a disposable MariaDB, wiped on every run.
# TEST_DATABASE_URL=mysql://root:change-me@127.0.0.1:3306/lotto_admin_test
# TEST_MONGODB_URL=
# TEST_MONGODB_DB=chokprathan_test
# Isolation test (src/server/db/isolation.test.ts), disposable server only:
# ISOLATION_MEMBER_URL=mysql://chok_member:CHANGE-ME-MEMBER@127.0.0.1:3306/lotto
# ISOLATION_ADMIN_URL=mysql://chok_admin:CHANGE-ME-ADMIN@127.0.0.1:3306/lotto
